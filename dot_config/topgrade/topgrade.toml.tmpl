[misc]
assume_yes = true

# disable specific steps
disable = ["containers", "git_repos", "helm", "pip3", "uv", "microsoft_office"]

ask_retry = false
auto_retry = 2

# Cleanup temporary or old files
cleanup = true

notify_end = "on_failure"

[brew]
autoremove = true

[cargo]
locked = true

{{ if eq .chezmoi.os "linux" -}}
[commands]
#"Prezto Update" = "$HOME/.config/zsh/.zprezto/init.zsh zprezto-update"
{{ end -}}

[firmware]
# Offer to update firmware; if false just check for and display available updates
upgrade = true

[flatpak]
# Use sudo for updating the system-wide installation
use_sudo = false
